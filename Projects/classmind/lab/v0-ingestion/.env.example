# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (matches .env.* in the repo's root .gitignore);
# this file is tracked.

# Supabase project settings — Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose this to the
# browser, never import it outside src/lib/supabase/server.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Used from Milestone 2 onward (Audio Ingestion). Milestone 0's blocker —
# Sarvam's terms on secondary use of submitted audio — was cleared on
# 2026-08-21, so this may now be filled in. Public lecture audio only: no
# real classroom recording until the consent and data-protection position
# exists. See README.md "Blocked until".
SARVAM_API_KEY=
