# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (matches .env.* in the repo's root .gitignore);
# this file is tracked.

# Supabase project settings — Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose this to the
# browser, never import it outside src/lib/supabase/server.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Used from Milestone 2 onward (Audio Ingestion). Do not request or fill
# this in until Milestone 0's blocker is cleared — see README.md
# "Blocked until": Sarvam's terms on secondary use of submitted audio.
SARVAM_API_KEY=
