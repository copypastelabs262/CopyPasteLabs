# Supabase project the product runs against.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Every read and write goes through a server route holding this key. RLS is on
# with zero policies, so the anon key alone can read nothing.
SUPABASE_SERVICE_ROLE_KEY=

# Live transcription.
SARVAM_API_KEY=

# TRANSCRIPTION_PROVIDER IS GONE. It is read nowhere in this codebase; setting
# it now does nothing at all. Replay used to be an ambient environment variable
# and the fixture used to be chosen by the uploaded FILENAME, which is how a
# lecture called "Cloud computing.mp3" came to be served a thermodynamics
# transcript on 2026-08-22. Replay is now per lecture and named explicitly:
# pass `replayFixture: "<slug>"` when creating the lecture. It is refused
# outright on any deployment and in any production build.

# Permits a real, billable Sarvam call from a developer machine. Off by default
# so an unmigrated script cannot spend money by accident; on a deployment a live
# call is the product and this variable is not consulted.
#
# It can ONLY enable spending. It cannot enable replay anywhere, ever.
ALLOW_LIVE_SARVAM=

# ---------------------------------------------------------------------------
# REASONING. Separate credentials, separate provider, separate budget.
# ---------------------------------------------------------------------------
#
# SARVAM_API_KEY above is TRANSCRIPTION ONLY, locked 2026-08-30. Once a
# transcript is stored, no processing step may call Sarvam again for that
# lecture. The reasoning path never reads that key unless ALLOW_PAID_REASONING
# is explicitly set, and it should not be.
#
# Which adapter answers. NO DEFAULT: unset is an error, not a reason to reach
# for whatever key happens to be lying around. That fallback is what spent a
# transcription budget on processing. One of: gemini | groq | ollama | sarvam.
REASONING_PROVIDER=gemini

# Gemini via its OpenAI-compatibility endpoint. Key from
# https://aistudio.google.com/apikey -- no credit card.
#
# Do NOT validate the key by its shape. An earlier version of this file claimed
# a valid key is 39 characters starting with "AIza"; the key that actually
# authenticated on 2026-08-30 is 53 characters and starts with neither. Length
# and prefix are not a contract, and treating them as one sent a working setup
# down a debugging path it did not belong on.
#
# Read Google's status code instead -- it says precisely which thing is wrong:
#   400 "Please pass a valid API key"  the key is malformed or not a key at all
#                                      (a placeholder, an unresolved secret
#                                      reference, angle brackets left around it)
#   401 / 403                          the key is real but not authorised
#   404                                the key is fine; GEMINI_MODEL is not a
#                                      model this account can address
#   429                                free-tier quota exhausted for now
#   503 UNAVAILABLE                    key, model and request are all CORRECT;
#                                      the model is momentarily saturated. Wait
#                                      and retry, or use an older Flash model.
#
# `npm run verify:provider` makes exactly one call and prints which of these
# happened, without ever printing the key.
#
# NOTE: the free tier uses submitted prompts for training. Acceptable for your
# own recordings; NOT acceptable once a partner college's lecture is in the
# system. Move to Groq or paid Gemini at that point -- one variable.
GEMINI_API_KEY=
# The model id is configuration, never a hardcoded default. Free tier currently
# covers Flash and Flash-Lite only; check your project's real limits at
# https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.7-flash
# Optional. Defaults to https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_BASE_URL=

# Groq. Contractually does not train on your data and offers zero data
# retention, which is why it is the provider to switch to when real student
# data arrives -- and the second opinion for cross-provider evaluation.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=

# Local, for plumbing and offline determinism. Authenticates nothing.
OLLAMA_MODEL=
OLLAMA_BASE_URL=

# THE ONLY THING THAT RE-ENABLES PAID REASONING. Must be exactly "1".
# Leave unset in development and in production. Setting it lets Sarvam be used
# as a reasoning provider again, which the locked rule forbids; it exists so a
# future controlled evaluation is possible, not so a fallback is.
ALLOW_PAID_REASONING=
