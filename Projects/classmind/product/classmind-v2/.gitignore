# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch
/.scratch/

.vercel
.env*

# .env.example documents the required variables and MUST be tracked.
# It sits last because git applies the last matching rule, and a duplicate
# ".env*" above re-swallowed it. Same defect as 2026-08-07 in v1; it came
# back when the app was forked. Verify with: git check-ignore -v .env.example
!.env.example

# Cross-provider evaluation baselines.
# These reproduce substantial verbatim speech from real, identifiable lecturers
# (the dfd7312d baseline carries 38.7% of that transcript across 56 spans), and
# consent is still an open item in .knowledge/progress.md. Kept local until
# there is a consent mechanism, because scripts/autosave.sh runs `git add -A`
# and would otherwise push them to GitHub without anyone deciding to.
fixtures/evaluation/
