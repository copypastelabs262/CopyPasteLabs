# Supabase project the product runs against.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Every read and write goes through a server route holding this key. RLS is on
# with zero policies, so the anon key alone can read nothing.
SUPABASE_SERVICE_ROLE_KEY=

# Live transcription. Leave TRANSCRIPTION_PROVIDER unset to use it.
SARVAM_API_KEY=

# Set to `fixture` to replay captured Lab v0 RUN 1 responses instead of calling
# Sarvam. Never set this in production: it stores a transcript the audio did
# not produce (the provenance record says so, loudly).
TRANSCRIPTION_PROVIDER=
