# ─────────────────────────────────────────────────────────────
# SECRETS — never commit these.
# Everything pushed to GitHub should be assumed permanent. If a key ever
# lands here by accident, rotate it immediately — deleting the file is NOT
# enough, because it stays in the repository history forever.
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
credentials.json
secrets.json
service-account*.json
*-credentials.*
*_secret*
*.secret

# Cloud / service credentials
.aws/
.gcloud/
.firebaserc
firebase-debug.log

# ─────────────────────────────────────────────────────────────
# Claude Code — machine-local state only
# ─────────────────────────────────────────────────────────────
.claude/settings.local.json

# Session start marker, written by scripts/session-start.sh and read by
# End-Session to compute session duration. Describes one machine's current
# session, not the repository's state — committing it would be meaningless to
# anyone else and would churn on every session.
.claude/.session-start

# ─────────────────────────────────────────────────────────────
# Dependencies — reinstallable, huge, never committed
# ─────────────────────────────────────────────────────────────
node_modules/
bower_components/
vendor/
.pnp
.pnp.js

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
pip-log.txt

# ─────────────────────────────────────────────────────────────
# Build output — regenerated, not source
# ─────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────
# Logs and caches
# ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
.parcel-cache/
.eslintcache
coverage/
.pytest_cache/
.mypy_cache/

# ─────────────────────────────────────────────────────────────
# Databases — local dev data, not source
# ─────────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db

# ─────────────────────────────────────────────────────────────
# Lab data — audio, transcripts and run output
#
# autosave.sh runs `git add -A` after every edit, so an unignored
# lecture recording would be committed automatically and permanently.
# A 40-minute WAV is 200-400 MB; GitHub's per-file hard limit is 100 MB.
#
# Beyond size: classroom audio contains identifiable students, and we
# have no consent position and have not read Sarvam's terms on secondary
# use. Audio does not enter a shared repository until both are settled.
#
# Every directory's README.md stays tracked so the structure and the
# regeneration command survive.
# ─────────────────────────────────────────────────────────────
Projects/*/lab/data/**
!Projects/*/lab/data/**/
!Projects/*/lab/data/**/README.md
!Projects/*/lab/data/README.md

# Media, wherever it lands
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.opus
*.aac
*.wma
*.mp4
*.mkv
*.mov
*.avi
*.webm

# ─────────────────────────────────────────────────────────────
# Editor and OS junk
# ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────────────────────
# Temporary
# ─────────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
.knowledge-bootstrap/
