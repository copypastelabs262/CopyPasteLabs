{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-start.sh\"",
            "timeout": 20,
            "statusMessage": "Pulling latest from GitHub..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/autosave.sh\"",
            "timeout": 45,
            "async": true,
            "statusMessage": "Saving to GitHub..."
          }
        ]
      }
    ]
  }
}
